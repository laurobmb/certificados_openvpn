client
dev tun
proto udp
remote {{ item.0.ip_externo }}
port {{ item.0.port }}
resolv-retry infinite
nobind
persist-key
persist-tun
comp-lzo
verb 3
key-direction 1

<tls-auth>
{{ tls_certificate_on_localhost.content | b64decode }}
</tls-auth>

<ca>
{{ ca_certificate_on_localhost.content | b64decode }}
</ca>

<cert>
{{ item.2.content | b64decode }}
</cert>

<key>
{{ item.1.content | b64decode }}
</key>
